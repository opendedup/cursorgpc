#!/usr/bin/env bash
# Print the latest version of a Secret Manager secret.
#
# Authenticates with the VM service account token from the metadata server, so
# the worker image needs no gcloud install and no key material on disk.
#
# Usage: cursor-worker-secret <secret-id> [project-id]
set -euo pipefail

SECRET_ID="${1:?usage: cursor-worker-secret <secret-id> [project-id]}"
PROJECT_ID="${2:-${CURSOR_GCP_PROJECT_ID:-}}"

METADATA_ROOT="http://metadata.google.internal/computeMetadata/v1"
ATTEMPTS="${CURSOR_SECRET_FETCH_ATTEMPTS:-30}"
DELAY="${CURSOR_SECRET_FETCH_DELAY:-10}"

metadata() {
  curl --silent --fail --max-time 10 \
    --header 'Metadata-Flavor: Google' \
    "${METADATA_ROOT}/$1"
}

if [[ -z "$PROJECT_ID" ]]; then
  PROJECT_ID="$(metadata project/project-id)"
fi

fetch_secret() {
  local token payload

  token="$(metadata instance/service-accounts/default/token | jq -r '.access_token // empty')"
  if [[ -z "$token" ]]; then
    echo "cursor-worker-secret: no access token from the metadata server" >&2
    return 1
  fi

  payload="$(curl --silent --fail --max-time 20 \
    --header "Authorization: Bearer ${token}" \
    "https://secretmanager.googleapis.com/v1/projects/${PROJECT_ID}/secrets/${SECRET_ID}/versions/latest:access" |
    jq -r '.payload.data // empty')"

  if [[ -z "$payload" ]]; then
    return 1
  fi

  # Trailing whitespace is stripped so a key stored with `echo` still works.
  printf '%s' "$payload" | tr -d '\n' | base64 --decode | sed -e 's/[[:space:]]*$//'
}

for ((attempt = 1; attempt <= ATTEMPTS; attempt++)); do
  if value="$(fetch_secret)" && [[ -n "$value" ]]; then
    printf '%s' "$value"
    exit 0
  fi

  echo "cursor-worker-secret: secret ${SECRET_ID} not readable yet (attempt ${attempt}/${ATTEMPTS})" >&2
  sleep "$DELAY"
done

echo "cursor-worker-secret: giving up on secret ${SECRET_ID} in project ${PROJECT_ID}" >&2
exit 1
